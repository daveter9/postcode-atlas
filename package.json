{
  "name": "postcode-atlas",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/compress.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "build:pages": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && ng build",
    "perf:frames": "node tests/frames.mjs",
    "data:pc6": "node --max-old-space-size=8192 scripts/build-pc6.mjs",
    "data:adr": "node --max-old-space-size=8192 scripts/build-adr.mjs",
    "deploy": "npm run build:pages && npx wrangler@4 deploy",
    "preview": "npm run build && wrangler dev",
    "test:e2e": "node tests/e2e.mjs",
    "test:load": "node tests/load.mjs",
    "test:lighthouse": "node tests/lighthouse.mjs",
    "test:all": "npm run build:pages && node tests/e2e.mjs && node tests/load.mjs --assert && node tests/lighthouse.mjs --assert && node tests/frames.mjs",
    "board": "node scripts/board.mjs",
    "prepare":"git config core.hooksPath .githooks || true"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "mapshaper": "^0.7.101",
    "polylabel": "^2.1.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.160.0"
  }
}
