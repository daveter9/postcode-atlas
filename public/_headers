# Cloudflare Pages response headers (ignored by other hosts; nginx uses deploy/nginx.conf).
# Cloudflare Web Analytics (enabled in the Pages dashboard) injects its beacon script; the CSP
# allows exactly that script and its reporting endpoint.
# index.html keeps Pages' default "max-age=0, must-revalidate" + ETag: a return visit costs one 304.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-LMY6wYoFV9I4wWzxaq1N/dTpl4iurQktw706UCHK3vM=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# content-hashed bundles: never change
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# data files have a hash in their file or directory name. Cloudflare only compresses known
# content types and application/octet-stream is not one of them; x-protobuf is.
/data/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/x-protobuf
